 108:Application/detect_task.c **** 
 109:Application/detect_task.c **** void Detect_Hook(uint8_t toe)
 110:Application/detect_task.c **** {
 111:Application/detect_task.c ****     Detect_List[toe].Last_Time = Detect_List[toe].New_Time; // 更新上一次记录时间
 112:Application/detect_task.c ****     Detect_List[toe].New_Time = USER_GetTick();             // 记录本次时间
 113:Application/detect_task.c **** 
 114:Application/detect_task.c ****     // 进入此函数证明没有掉线
 115:Application/detect_task.c ****     if (Detect_List[toe].is_Lost)
 116:Application/detect_task.c ****     {
 117:Application/detect_task.c ****         Detect_List[toe].is_Lost = 0;
 118:Application/detect_task.c ****         Detect_List[toe].Work_Time = Detect_List[toe].New_Time;
 119:Application/detect_task.c ****     }
 120:Application/detect_task.c **** 
 121:Application/detect_task.c ****     if (Detect_List[toe].f_is_Data_Error != NULL)
 122:Application/detect_task.c ****     {
 123:Application/detect_task.c ****         if (Detect_List[toe].f_is_Data_Error())
 124:Application/detect_task.c ****         {
 125:Application/detect_task.c ****             Detect_List[toe].Error_Exist = 1;
 126:Application/detect_task.c ****             Detect_List[toe].is_Data_Error = 1;
 127:Application/detect_task.c **** 
 128:Application/detect_task.c ****             if (Detect_List[toe].f_Solve_Data_Error != NULL)
 129:Application/detect_task.c ****             {
 130:Application/detect_task.c ****                 Detect_List[toe].f_Solve_Data_Error();
 131:Application/detect_task.c ****             }
 132:Application/detect_task.c ****         }
 133:Application/detect_task.c ****         else
 134:Application/detect_task.c ****         {
 135:Application/detect_task.c ****             Detect_List[toe].is_Data_Error = 0;
 136:Application/detect_task.c ****         }
 137:Application/detect_task.c ****     }
 138:Application/detect_task.c ****     else
 139:Application/detect_task.c ****     {
 140:Application/detect_task.c ****         Detect_List[toe].is_Data_Error = 0;
 141:Application/detect_task.c ****     }
 142:Application/detect_task.c **** }
