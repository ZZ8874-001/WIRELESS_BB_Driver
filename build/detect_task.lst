  33:Application/detect_task.c **** void Detect_Task(void)
  34:Application/detect_task.c **** {
  35:Application/detect_task.c ****     static uint32_t system_time;
  36:Application/detect_task.c ****     static uint8_t error_num_display = 0;
  37:Application/detect_task.c ****     system_time = USER_GetTick();
  38:Application/detect_task.c **** 
  39:Application/detect_task.c ****     error_num_display = DETECT_LIST_LENGHT;
  40:Application/detect_task.c ****     Detect_List[DETECT_LIST_LENGHT].is_Lost = 0;
  41:Application/detect_task.c ****     Detect_List[DETECT_LIST_LENGHT].Error_Exist = 0;
  42:Application/detect_task.c **** 
  43:Application/detect_task.c ****     for (int i = 0; i < DETECT_LIST_LENGHT; i++)
  44:Application/detect_task.c ****     {
  45:Application/detect_task.c ****         if (Detect_List[i].Enable == 0)
  46:Application/detect_task.c ****         {
  47:Application/detect_task.c ****             continue;
  48:Application/detect_task.c ****         }
  49:Application/detect_task.c **** 
  50:Application/detect_task.c ****         // 掉线判断
  51:Application/detect_task.c ****         if (system_time - Detect_List[i].New_Time > Detect_List[i].Offline_Time)
  52:Application/detect_task.c ****         {
  53:Application/detect_task.c ****             if (Detect_List[i].Error_Exist == 0)
  54:Application/detect_task.c ****             {
  55:Application/detect_task.c ****                 // 记录错误以及掉线时间
  56:Application/detect_task.c ****                 Detect_List[i].is_Lost = 1;
  57:Application/detect_task.c ****                 Detect_List[i].Error_Exist = 1;
  58:Application/detect_task.c ****                 Detect_List[i].Lost_Time = system_time;
  59:Application/detect_task.c ****             }
  60:Application/detect_task.c **** 
  61:Application/detect_task.c ****             // 保存优先级最高的错误码
  62:Application/detect_task.c ****             if (Detect_List[i].Priority > Detect_List[error_num_display].Priority)
  63:Application/detect_task.c ****             {
  64:Application/detect_task.c ****                 error_num_display = i;
  65:Application/detect_task.c ****             }
  66:Application/detect_task.c **** 
  67:Application/detect_task.c ****             Detect_List[DETECT_LIST_LENGHT].is_Lost = 1;
  68:Application/detect_task.c ****             Detect_List[DETECT_LIST_LENGHT].Error_Exist = 1;
  69:Application/detect_task.c **** 
  70:Application/detect_task.c ****             // 如果提供解决函数，运行解决函数
  71:Application/detect_task.c ****             if (Detect_List[i].f_Solve_Lost != NULL)
  72:Application/detect_task.c ****             {
  73:Application/detect_task.c ****                 Detect_List[i].f_Solve_Lost();
  74:Application/detect_task.c ****             }
  75:Application/detect_task.c ****         }
  76:Application/detect_task.c ****         else if (system_time - Detect_List[i].Work_Time < Detect_List[i].Online_Time)
  77:Application/detect_task.c ****         {
  78:Application/detect_task.c ****             // 刚刚上线，可能存在数据不稳定，只记录不丢失，
  79:Application/detect_task.c ****             Detect_List[i].is_Lost = 0;
  80:Application/detect_task.c ****             Detect_List[i].Error_Exist = 1;
  81:Application/detect_task.c ****         }
  82:Application/detect_task.c ****         else
  83:Application/detect_task.c ****         {
  84:Application/detect_task.c ****             Detect_List[i].is_Lost = 0;
  85:Application/detect_task.c ****             // 判断是否存在数据错误
  86:Application/detect_task.c ****             if (Detect_List[i].is_Data_Error != NULL)
  87:Application/detect_task.c ****             {
ARM GAS  C:\Users\SHUCHE~1\AppData\Local\Temp\ccZho8bq.s 			page 3


